<resources>
    <style name="Theme.VctTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bone</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VctTracker.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VctTracker</item>
    </style>
</resources>
